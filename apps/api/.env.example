# API — copia a apps/api/.env para desarrollo local.

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_LOG_LEVEL=info

DATABASE_URL=postgres://euromex:change_me_in_prod@127.0.0.1:5432/euromex_chat
REDIS_URL=redis://default:change_me_in_prod@127.0.0.1:6379

# JWT (Fase 2). Genera con: openssl rand -base64 48
JWT_SECRET=replace_me_with_long_random_string
JWT_TTL_SEC=28800

# Clave maestra AES-256-GCM para cifrar secretos TOTP en DB.
# Genera con: openssl rand -base64 32
# (32 bytes exactos; NO la pierdas, pierdes los TOTP de todos los usuarios)
MASTER_ENC_KEY=replace_me_with_32_bytes_base64

# Orígenes web permitidos (CORS). Lista separada por coma.
CORS_ORIGINS=http://localhost:3100
