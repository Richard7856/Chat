# Capacitor genera el proyecto Android Studio aquí. Lo trackeamos PARCIALMENTE:
# las customizaciones (plugin de seguridad, AndroidManifest tweaks, recursos)
# se commitean; los outputs de build no.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/release/
android/app/debug/
android/captures/
android/.idea/
android/.kotlin/
*.apk
*.aab
*.keystore
*.jks

# Capacitor caches
.capacitor/
node_modules/

# Build artifacts (APK/AAB) — son outputs, regenerables
dist/

# iOS — proyecto Xcode, trackeamos sources pero no Pods/ ni build/
# Pods se regenera con `pnpm cap sync ios` después de tener Xcode + CocoaPods
ios/App/Pods/
ios/App/build/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
*.xcuserstate
*.mobileprovision
*.p12

# Release keystore (NUNCA commitear; ver PUBLISHING.md)
android/app/*.keystore
android/app/*.jks
android/key.properties
