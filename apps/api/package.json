{
  "name": "@euromex/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(lint pendiente)\"",
    "test": "echo \"(tests pendientes)\"",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "reset-password": "tsx src/scripts/reset-password.ts",
    "generate-vapid": "tsx src/scripts/generate-vapid.ts",
    "cleanup-devices": "tsx src/scripts/cleanup-duplicate-devices.ts",
    "migrate": "tsx src/scripts/migrate.ts apply",
    "migrate:status": "tsx src/scripts/migrate.ts status",
    "migrate:dry-run": "tsx src/scripts/migrate.ts dry-run",
    "migrate:bootstrap": "tsx src/scripts/migrate.ts bootstrap"
  },
  "dependencies": {
    "@euromex/shared": "workspace:*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "otpauth": "^9.3.5",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
